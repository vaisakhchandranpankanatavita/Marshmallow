# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# These belong to your SERVER only. They must never reach the browser, which
# means never prefixing them with VITE_, REACT_APP_ or NEXT_PUBLIC_ — anything
# with those prefixes is compiled into the JS bundle and served to every
# visitor. A Qikink client secret in a public bundle lets anyone place print
# orders billed to your account.

QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_BASE_URL=

# Payment gateway (Shopify Payments does not operate in India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only the publishable/checkout key may be exposed to the client
VITE_RAZORPAY_KEY_ID=
