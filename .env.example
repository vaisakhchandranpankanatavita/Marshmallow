# Copy to .env and fill in. .env is gitignored — keep it that way.
#
# These belong to your SERVER only. Never commit this file and never prefix
# them with VITE_, REACT_APP_ or NEXT_PUBLIC_ — those prefixes compile the
# values into the JS bundle and publish them to every visitor. A Qikink client
# secret in a public bundle lets anyone place real print orders billed to your
# account.

# Qikink (print-on-demand)
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_MODE=sandbox
# Qikink needs a publicly-reachable base URL for artwork downloads (they download your SVGs)
PUBLIC_BASE_URL=

# Razorpay (payment gateway — optional, enables prepaid checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Server config
PORT=4000
